{
  "expo": {
    "name": "ExpenseAi",
    "slug": "expenseai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/expenseai-icon.png",
    "scheme": "expenseai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.expenseai.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.expenseai.app",
      "adaptiveIcon": {
        "backgroundColor": "#457046",
        "foregroundImage": "./assets/images/expenseai-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/expenseai-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/expenseai-logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#457046",
          "dark": {
            "backgroundColor": "#457046"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-camera",
        {
        "cameraPermission": "Allow ExpenseAi to take photos of receipts."
        }
      ],
      [
        "expo-audio",
        {
        "microphonePermission": "Allow ExpenseAi to record a voice transaction."
        }
      ],
      [
        "expo-image-picker",
        {
        "photosPermission": "Allow ExpenseAi to select a receipt photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
